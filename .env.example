# Copier en .env et adapter. Aucun secret n'est versionne.

# Cle de signature des sessions. Obligatoire en production :
# sans elle, GAAP genere une cle ephemere et le signale dans les journaux.
GAAP_SECRET_KEY=

# Chemin de la base SQLite.
GAAP_DATABASE=instance/gaap.sqlite

# Profil : development | testing | production
GAAP_ENV=development

# Identite par defaut des actions non authentifiees. En integration reelle,
# elle est remplacee par l'en-tete X-GAAP-Actor issu du dispositif
# d'authentification de l'etablissement.
GAAP_ACTOR=analyste@exemple.be
